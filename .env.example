# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here

# Cloud Messaging / web push (sales agent owner alerts).
# Sender id and app id: Firebase console -> Project settings -> General.
# VAPID key: Firebase console -> Cloud Messaging -> Web Push certificates.
# Leave blank and push simply reports itself as not set up.
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here
VITE_FIREBASE_VAPID_KEY=your_web_push_vapid_key_here

# Google OAuth
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Admin Configuration
VITE_ADMIN_EMAIL=your_admin_email_here
VITE_ADMIN_UID=your_admin_uid_here

# Gemini AI
VITE_GEMINI_API_KEY=your_gemini_api_key_here
