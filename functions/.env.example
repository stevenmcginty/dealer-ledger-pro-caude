# DVSA MOT History API (required for vehicle registration lookup)
# Issued by DVSA on approval of the MOT History API application.
# Docs: https://documentation.history.mot.api.gov.uk/
MOT_CLIENT_ID=your-client-id
MOT_CLIENT_SECRET=your-client-secret
MOT_API_KEY=your-api-key
MOT_TOKEN_URL=https://login.microsoftonline.com/your-tenant-id/oauth2/v2.0/token
MOT_SCOPE_URL=https://tapi.dvsa.gov.uk/.default

# DVLA Vehicle Enquiry Service (optional second source)
# Adds tax status, tax due date, CO2, euro status and V5C issue date, and covers
# vehicles too new to have an MOT record. The lookup works without it.
# Apply at: https://developer-portal.driver-vehicle-licensing.api.gov.uk/
DVLA_VES_API_KEY=

# Running cost assumptions (all optional).
# No API publishes what a car costs to run, so the lookup works it out from CO2
# and the published VED tables. The road tax figure needs nothing here. The fuel
# figures need a pump price, and a stale default would be silently wrong — so
# every estimate repeats the price it used. Update these when prices move.
# Defaults: 139.9p petrol, 147.9p diesel, 7.5p/kWh home charging, 10,000 miles.
FUEL_PETROL_PENCE=
FUEL_DIESEL_PENCE=
FUEL_ELECTRIC_PENCE_KWH=
FUEL_MILES_PER_YEAR=
