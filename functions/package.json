{
  "name": "dealer-ledger-pro-functions",
  "version": "1.0.0",
  "description": "Firebase Cloud Functions for Dealer Ledger Pro",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^6.6.0",
    "@google/genai": "^1.9.0",
    "cheerio": "^1.0.0",
    "googleapis": "^144.0.0",
    "twilio": "^5.3.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "@types/node": "^22.20.1"
  },
  "private": true
}
